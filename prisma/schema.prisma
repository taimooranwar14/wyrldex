generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  // Lets Node 24 run the seed directly (native TypeScript) without adding tsx.
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

/// Where a fact comes from. Shown in the UI so sample data is never mistaken for game canon.
enum Verification {
  official
  community
  sample
}

/// A virtual world (e.g. one game). Keeps the platform reusable beyond GTA VI.
model World {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  description String
  locations   Location[]
  characters  Character[]
}

model Location {
  id           String       @id @default(cuid())
  worldId      String
  world        World        @relation(fields: [worldId], references: [id], onDelete: Cascade)
  slug         String
  name         String
  category     String
  /// Parent region (e.g. "Vice City") for places inside one of Leonida's regions; null for the regions themselves or when unknown.
  region       String?
  /// 0–1 position on our original stylized map, NOT real in-game coordinates.
  x            Float
  y            Float
  summary      String
  verification Verification
  /// Where the facts come from. Required for official/community records; summaries are written in our own words.
  sourceUrl    String?
  connections  Connection[]

  @@unique([worldId, slug])
  @@index([worldId, category])
}

model Character {
  id           String       @id @default(cuid())
  worldId      String
  world        World        @relation(fields: [worldId], references: [id], onDelete: Cascade)
  slug         String
  name         String
  summary      String
  verification Verification
  sourceUrl    String?
  connections  Connection[]

  @@unique([worldId, slug])
}

/// A sourced link between a character and a place (e.g. "her story opens here"). Each claim carries its own provenance.
model Connection {
  id           String       @id @default(cuid())
  characterId  String
  character    Character    @relation(fields: [characterId], references: [id], onDelete: Cascade)
  locationId   String
  location     Location     @relation(fields: [locationId], references: [id], onDelete: Cascade)
  note         String
  verification Verification
  sourceUrl    String?

  @@unique([characterId, locationId])
}
